# Local development environment for PaceTrain.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=file:./data/pacetrain.db

# --- auth -----------------------------------------------------------------
# 32+ random bytes, hex. Rotating this signs everybody out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Open registration. Set to "false" to close sign-up (invite-only).
ALLOW_SIGNUP=true
# Comma separated. These addresses get the admin role on first sign-up.
ADMIN_EMAILS=

# --- shared DeepSeek key (server only, never exposed to the browser) ------
# Leave DEEPSEEK_API_KEY empty to run the coach in offline mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Hard daily ceiling across all users. When reached, AI answers are paused
# until 00:00 UTC. Set to 0 to disable the ceiling.
DAILY_TOKEN_BUDGET=1500000

# --- stored intervals.icu keys (AES-256-GCM) -----------------------------
# 32 bytes, base64. Changing this makes previously stored keys unreadable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- email ----------------------------------------------------------------
# Only password resets are mailed; sign-up asks for the address instead.
# console = print the reset link to the server log (and /dev/mailbox).
# resend  = send real mail through Resend (needs RESEND_API_KEY + EMAIL_FROM).
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=PaceTrain <no-reply@pacetrain.local>

# --- payments (paywall) ---------------------------------------------------
# There is no checkout on the site. The prices are shown on /pricing and the
# athlete emails this address to buy; you then switch the period on in /billing
# (admin → Grant access) after the payment has arrived.
CONTACT_EMAIL=

# true  = an active period is required to use the app (admins always get in)
# false = the paywall is off for everyone; nothing else changes
PAYWALL_ENABLED=true
